# Required: Get from https://neon.tech (free tier works)
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=your_url_here

# Required: Get from https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=your_key_here

# Required: Get from https://www.groq.com
GROQ_API_KEY=your_key_here

# Note: Embeddings run LOCALLY via HuggingFace (BAAI/bge-small-en-v1.5).
# No embedding API key is needed. The model (~133 MB) downloads automatically
# on first run to ~/.cache/huggingface/